# ============================================
# KINDS API 설정 (필수)
# ============================================
# BIG KINDS API 키를 발급받아 입력하세요
# 발급: https://www.bigkinds.or.kr/ → 마이페이지 → API 신청
KINDS_ACCESS_KEY=your_kinds_api_key_here

# ============================================
# OpenAI API 설정 (이미지 생성용, 선택사항)
# ============================================
# OpenAI API 키 (이미지 생성 기능 사용 시 필요)
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# 서버 설정 (선택사항)
# ============================================
# 서버 포트 (기본값: 8000)
PORT=8000

# 호스트 (기본값: 0.0.0.0)
HOST=0.0.0.0
